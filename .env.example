# Copia este archivo como .env y completa los valores. El .env no se sube al repositorio.

# Puerto local de la API (el frontend usa el 3000).
PORT=3001

# Supabase > botón "Connect" > Session pooler. Reemplaza [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=postgresql://postgres.TU-REF:[YOUR-PASSWORD]@aws-0-TU-REGION.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API > Project URL.
SUPABASE_URL=https://TU-REF.supabase.co

# Solo si tu proyecto usa el "Legacy JWT secret" (HS256). Con llaves asimétricas, déjalo vacío.
SUPABASE_JWT_SECRET=

# Orígenes del frontend, separados por coma.
CORS_ORIGINS=http://localhost:3000
