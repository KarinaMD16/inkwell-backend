# Copia este archivo como .env y completa los valores. El .env no se sube al repositorio.

# Puerto local de la API (el frontend usa el 3000).
PORT=3001

# Supabase > botón "Connect" > Session pooler. Reemplaza [YOUR-PASSWORD] por la contraseña de la base.
DATABASE_URL=postgresql://postgres.TU-REF:[YOUR-PASSWORD]@aws-0-TU-REGION.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API > Project URL.
SUPABASE_URL=https://TU-REF.supabase.co

# Solo si tu proyecto usa el "Legacy JWT secret" (HS256). Con llaves asimétricas, déjalo vacío.
SUPABASE_JWT_SECRET=

# Orígenes del frontend, separados por coma. Nunca "*": la sesión viaja en una cookie.
CORS_ORIGINS=http://localhost:3000
# Solo en desarrollo, para abrir la web desde el teléfono (misma red wifi): 1 acepta también
# http://192.168.x.x:3000 y parecidas. Nunca en producción (la API no arranca si lo ve ahí).
ALLOW_LAN_ORIGINS=0

# Nombre de la cookie HttpOnly con la sesión. Debe ser el mismo AUTH_COOKIE del frontend.
AUTH_COOKIE=ink_at

# Supabase > Project Settings > API > service_role (secreta). Solo la usa "eliminar mi cuenta".
# Nunca la pongas en el frontend ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Cuántos proxies hay delante de la API. En Render: 1. En local: 0.
TRUST_PROXY=0

# Peticiones por minuto por IP. Las rutas de cuenta y subidas tienen un límite menor (20).
RATE_LIMIT_PER_MINUTE=300

# Imágenes de perfil y portadas (almacenamiento compatible con S3). Si lo dejas vacío,
# la API funciona igual y solo la subida de imágenes responde "no configurada".
# Supabase > Storage > S3 Configuration (ahí están el endpoint, la región y las llaves de acceso).
STORAGE_ENDPOINT=https://TU-REF.storage.supabase.co/storage/v1/s3
STORAGE_REGION=us-east-1
STORAGE_BUCKET=perfiles
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=https://TU-REF.supabase.co/storage/v1/object/public/perfiles

# Correos que siempre tienen rol admin, separados por coma. Así nace la primera cuenta de administración.
ADMIN_EMAILS=
